// This is your Prisma schema file,
// learn to use it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkinTier {
  FREE
  BASIC
  PREMIUM
}

model User {
  id             String   @id @default(ulid())
  email          String   @unique
  identification String?  @unique
  name           String?
  googleId       String?  @unique
  microsoftId    String?  @unique
  buymeId        String?  @unique
  isDonor        Boolean  @default(false)
  donorAvatars   Int      @default(0)

  // Skin system
  skinTier     SkinTier @default(FREE)
  selectedSkin String   @default("character-d")

  // Relations
  payments         Payment[]
  skinPurchases    SkinPurchase[]
  userAchievements UserAchievement[]
}

model Payment {
  id            String   @id @default(cuid())
  correlationId String   @unique
  value         Int      // Store value in cents
  provider      String   @default("woovi")
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED
  purpose       String   @default("donation") // "donation" | "skin_basic" | "skin_premium"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  skinPurchase SkinPurchase?
}

model SkinPurchase {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tier       SkinTier
  amountPaid Int // valor em centavos
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────────────────────────
// Achievements
// ───────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "FIRST_BLOOD"
  title       String
  description String
  icon        String   @default("🏆")
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}
