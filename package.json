{
  "name": "bomberman",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx ng serve --port 4000",
    "build": "npx ng build",
    "watch": "npx ng build --watch --configuration development",
    "test": "npx ng test",
    "serve:ssr:bomberman": "node dist/bomberman/server/server.mjs",
    "migrate:dev": "npx prisma migrate dev",
    "migrate": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "postinstall": "npm run generate",
    "dev:ssr": "npx ng serve --configuration development --port 4000",
    "seed": "tsx prisma/seed.ts"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "i": "^0.3.7",
    "npm": "^12.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.3.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/three": "^0.185.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
