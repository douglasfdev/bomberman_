# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# Google OAuth 2.0
GOOGLE_CLIENT_ID="SEU_CLIENT_ID_DO_GOOGLE"
GOOGLE_CLIENT_SECRET="SEU_CLIENT_SECRET_DO_GOOGLE"

# Chave secreta para a sessão do Express
# Pode ser qualquer string aleatória e longa
SESSION_SECRET="SEU_SESSION_SECRET_SUPER_SEGURO"

# URL base da sua aplicação
APP_BASE_URL="http://localhost:4000"